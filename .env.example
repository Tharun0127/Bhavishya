# Copy to .env and fill in. Never commit .env.
#
# Not needed for the launch sources (Grid-India, CPCB bulletin, Open-Meteo are keyless).
# Needed for the planned Agmarknet mandi price source.
# How to get it: register at https://www.data.gov.in/, sign in, open "My Account",
# and copy the API key shown there. It is free.
DATA_GOV_IN_API_KEY=

# Where the arena keeps its vintage store. In CI this is a checkout of the `data` branch.
BHAVISHYA_DATA_DIR=arena-data
